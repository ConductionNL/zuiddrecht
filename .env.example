# Copy to .env and change what you need. Every value has a default.

# Port on your machine
PORT=8080

# Password of the admin account, applied on first start
ADMIN_PASSWORD=admin

# Language of the demo boards: nl or en
DEMO_LANGUAGE=nl

# Password for the demo users (pieter, marieke, ...). Empty keeps the documented default.
DEMO_PASSWORD=

# Only when running behind a domain, for example zuiddrecht.example.nl
#TRUSTED_DOMAINS=localhost zuiddrecht.example.nl
#OVERWRITE_PROTOCOL=https
#OVERWRITE_CLI_URL=https://zuiddrecht.example.nl

# Image tag: latest, or a pinned version such as 2026.11.27
ZUIDDRECHT_TAG=latest
